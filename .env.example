# ---- Supabase (Project Settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Used only by /api/cron/deadlines.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Random string; Vercel sends it as "Authorization: Bearer <CRON_SECRET>" to cron routes
CRON_SECRET=generate-a-long-random-string

# ---- Optional: email notifications (not required; app works without it) ----
# RESEND_API_KEY=
# EMAIL_FROM="InternLink <no-reply@yourdomain.com>"
